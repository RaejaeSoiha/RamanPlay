# Copy to .env at the project root. Never commit .env.
# Blank DATABASE_URL uses SQLite at backend/watch.db.
DATABASE_URL=sqlite:///./watch.db
SPORTSDATAIO_API_KEY=
# Blank selects the relevant season automatically (Jan/Feb use previous year).
NFL_SEASON=
# Set true only for scrambled/trial SportsDataIO feeds. False is for production data.
SPORTSDATA_TRIAL=false
ADMIN_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# auto uses ESPN's public scoreboard feed. Set development only for local sample data.
DATA_PROVIDER=auto
# Optional absolute path to a JSON feed, default data/seeds/schedule.json
# SCHEDULE_FILE=/absolute/path/to/full-schedule.json
USER_AGENT=RamanPlay/1.0 (personal link checker)
SCHEDULE_HOURS=6
LIVE_REFRESH_SECONDS=120
LINK_CHECK_HOURS=6
REQUEST_INTERVAL_SECONDS=2
SCHEDULER_ENABLED=true
# Docker only: set a unique database password.
POSTGRES_PASSWORD=
# Backend URL is set in frontend/.env.local, or as a Docker build argument.
# BACKEND_URL=http://127.0.0.1:8000

GAME_DAY_REFRESH_SECONDS=900
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_RETRIES=2
