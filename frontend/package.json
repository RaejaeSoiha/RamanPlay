{
  "name": "ramanplay",
  "version": "1.0.0",
  "description": "RamanPlay — All Your Games. One Place.",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "concurrently \"cd ../backend && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000\" \"next start\"",
    "start:dev": "concurrently \"cd ../backend && .venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8000\" \"next dev --webpack\"",
    "test": "vitest run"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.4",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
